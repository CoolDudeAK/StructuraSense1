# Copy this file to .env and edit. Never commit .env. Everything here is optional.
SS_HOST=127.0.0.1
SS_PORT=5000
# SS_SECRET_KEY=            # leave empty: a random key is created once in data/.secret_key
# SS_DEMO_PASSWORD=Sense@2026
# SS_SEED_DEMO=1            # 0 = start with an empty database
# SS_ALLOW_SIGNUP=1         # 0 = only admins can create accounts
# SS_SIM_AUTOSTART=1
# SS_CORS_ORIGIN=           # set if a separate front end calls this API

# Supabase mirror (server side only - never put these in front-end code)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=
